---
import Base from '../layouts/Base.astro';
import AttorneyNav from '../components/AttorneyNav.astro';
import Portrait from '../components/Portrait.astro';
import Julia from '../content/attorneys/julia.md';
import { attorneys } from '../lib/site';

const attorney = attorneys[1];
---

<Base
  title={attorney.name}
  description="Julia Austin Solaegui, Esq., Austin & Austin, Attorneys at Law. Practice focuses on estate planning."
>
  <div class="page">
    <div class="wrap">
      <h1>{attorney.name}</h1>
      <AttorneyNav current={attorney.href} />
      <div class="attorney-bio">
        <Portrait src={attorney.photo} alt="" />
        <div class="attorney-copy">
          <p class="education">{attorney.education.join(' · ')}</p>
          <Julia />
        </div>
      </div>
    </div>
  </div>
</Base>
