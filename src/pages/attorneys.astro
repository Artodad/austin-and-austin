---
import Base from '../layouts/Base.astro';
import AttorneyNav from '../components/AttorneyNav.astro';
import Portrait from '../components/Portrait.astro';
import { attorneys, withBase } from '../lib/site';
---

<Base
  title="Attorneys"
  description="Albert John Austin, Esq. and Julia Austin Solaegui, Esq., Austin & Austin, Attorneys at Law."
>
  <div class="page">
    <div class="wrap">
      <h1>Attorneys</h1>
      <AttorneyNav current="index" />

      <ul class="attorney-index">
        {
          attorneys.map((attorney) => (
            <li>
              <a class="attorney-card" href={withBase(attorney.href)}>
                <Portrait src={attorney.photo} alt="" />
                <h2>{attorney.name}</h2>
                <p class="role">{attorney.role}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Base>
