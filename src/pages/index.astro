---
import Base from '../layouts/Base.astro';
import {
  engineSignInHref,
  homeDisclaimer,
  offices,
  phoneDisplay,
  phoneHref,
  withBase,
} from '../lib/site';

const signInHref = engineSignInHref();

const homeDoors = [
  {
    href: 'estate-planning',
    label: 'Estate planning',
    note: 'Wills, trusts, power of attorney',
  },
  {
    href: 'probate-trust-administration',
    label: 'Probate',
    note: 'Trust administration, accounting',
  },
] as const;
---

<Base title="Home" hideFooter>
  <div class="home">
    <h1 class="visually-hidden">Austin &amp; Austin, Attorneys at Law</h1>

    <figure class="home-photo">
      <img
        src={withBase('photos/library.jpg')}
        alt="Julia Austin Solaegui and Albert John Austin seated in the firm library."
        width="1600"
        height="1067"
      />
      <figcaption>Julia Austin Solaegui and Albert John Austin</figcaption>
    </figure>

    <ol class="doors">
      {
        homeDoors.map((door) => (
          <li>
            <a class="door" href={withBase(door.href)}>
              {door.label}
            </a>
            <p class="door-note">{door.note}</p>
          </li>
        ))
      }
      <li>
        <a class="door door-call" href={phoneHref}>Call {phoneDisplay}</a>
        <p class="door-note">El Cajon and Ramona</p>
      </li>
    </ol>

    <ol class="doors doors-pair">
      <li>
        <a class="door" href={withBase('blog')}>Blog</a>
        <p class="door-note">Estate planning notes, 2015–2022</p>
      </li>
      <li>
        {
          signInHref ? (
            <a class="door" href={signInHref}>
              Login
            </a>
          ) : (
            <span class="door">Login</span>
          )
        }
        <p class="door-note">Trust drafts.</p>
      </li>
    </ol>

    <section class="offices" aria-label="Offices">
      {
        offices.map((office) => (
          <div class="office">
            <p class="office-name">{office.name}</p>
            <address class="address">{office.lines.join(', ')}</address>
          </div>
        ))
      }
      <p class="office-travel">If needed, we will travel to meet you.</p>
    </section>

    <p class="home-disclaimer">{homeDisclaimer}</p>
  </div>
</Base>
