---
import Base from '../layouts/Base.astro';
import OfficesCopy from '../content/pages/offices.md';
import { offices, phoneDisplay, phoneHref, practiceAreas, withBase } from '../lib/site';

const homeDoors = practiceAreas.slice(0, 2);
---

<Base title="Home">
  <div class="page">
    <div class="wrap">
      <h1 class="visually-hidden">Austin &amp; Austin, Attorneys at Law</h1>
      <p class="lede">A family firm in El Cajon, established 1983.</p>
    </div>

    <figure class="home-photo">
      <img
        src={withBase('photos/library.jpg')}
        alt="Julia Austin Solaegui and Albert John Austin seated in the firm library."
        width="1600"
        height="1067"
      />
    </figure>

    <div class="wrap">
      <ol class="doors">
        {
          homeDoors.map((area) => (
            <li>
              <a class="door" href={withBase(area.href)}>
                {area.label}
              </a>
              <p class="door-note">{area.summary}</p>
            </li>
          ))
        }
        <li class="doors-call">
          <a class="phone door-call" href={phoneHref}>Call {phoneDisplay}</a>
        </li>
      </ol>

      <section class="offices" aria-labelledby="offices-heading">
        <h2 id="offices-heading">Offices</h2>
        <div class="office-grid">
          {
            offices.map((office) => (
              <div class="office">
                <h3>{office.name}</h3>
                <address class="address">
                  {office.lines.map((line) => (
                    <div>{line}</div>
                  ))}
                </address>
              </div>
            ))
          }
        </div>
        <OfficesCopy />
      </section>
    </div>
  </div>
</Base>
