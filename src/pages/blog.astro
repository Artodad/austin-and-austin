---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/site';

const posts = (await getCollection('blog')).sort((a, b) => {
  const byDate = b.data.date.valueOf() - a.data.date.valueOf();
  if (byDate !== 0) return byDate;
  return a.data.title.localeCompare(b.data.title);
});

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base
  title="Blog"
  description="Estate planning notes from Austin & Austin, Attorneys at Law, 2015–2022."
>
  <div class="page">
    <div class="wrap reading">
      <h1>Blog</h1>
      <ol class="blog-list">
        {
          posts.map((post) => (
            <li>
              <time datetime={post.data.date.toISOString().slice(0, 10)}>
                {dateFmt.format(post.data.date)}
              </time>
              <a href={withBase(`blog/${post.data.slug}`)}>{post.data.title}</a>
              <span class="author">{post.data.author}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</Base>
