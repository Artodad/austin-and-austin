---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base
  title="Blog"
  description="Estate planning notes from Austin & Austin, Attorneys at Law, 2015–2022."
>
  <div class="page">
    <div class="wrap reading">
      <h1>Blog</h1>
      <p>Titles from the existing 2015–2022 posts. Full text has not been moved over yet.</p>
      <ol class="blog-list">
        {
          posts.map((post) => (
            <li>
              <time datetime={post.data.date.toISOString().slice(0, 10)}>
                {dateFmt.format(post.data.date)}
              </time>
              <div>{post.data.title}</div>
              <div class="author">{post.data.author}</div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</Base>
