---
import {
  disclaimer,
  engineSignInHref,
  navItems,
  offices,
  phoneDisplay,
  phoneHref,
  rpcLine,
  withBase,
} from '../lib/site';

const signInHref = engineSignInHref();
---

<footer class="site-footer">
  <div class="wrap">
    <nav class="footer-nav" aria-label="Footer">
      {
        navItems.map((item) => (
          <a href={withBase(item.href)}>{item.label}</a>
        ))
      }
      {
        signInHref ? (
          <a href={signInHref}>Login</a>
        ) : (
          <span>Login</span>
        )
      }
    </nav>
    <div class="footer-offices">
      {
        offices.map((office) => (
          <p>
            {office.lines.join(', ')}
          </p>
        ))
      }
      <p><a class="phone" href={phoneHref}>{phoneDisplay}</a></p>
    </div>
    <p class="disclaimer">{disclaimer}</p>
    <p class="rpc">{rpcLine}</p>
  </div>
</footer>
