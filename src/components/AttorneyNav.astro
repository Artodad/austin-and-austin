---
import { attorneys, withBase } from '../lib/site';

interface Props {
  current?: 'index' | (typeof attorneys)[number]['href'];
}

const { current } = Astro.props;
---

<nav class="subnav" aria-label="Attorneys">
  <a href={withBase('attorneys')} aria-current={current === 'index' ? 'page' : undefined}>Both</a>
  {
    attorneys.map((attorney) => (
      <a
        href={withBase(attorney.href)}
        aria-current={current === attorney.href ? 'page' : undefined}
      >
        {attorney.navLabel}
      </a>
    ))
  }
</nav>
